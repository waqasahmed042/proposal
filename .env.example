# App config─
PUBLIC_BASE_URL=http://localhost:5000
# Once deployed:
# PUBLIC_BASE_URL=https://sign.conceptengineers.com.au

# Email (Gmail SMTP — free)─
# Setup:
#   1. Go to https://myaccount.google.com/security and enable 2-Step Verification.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" -> copy the 16-character code.
#   4. Put that code below as SMTP_PASSWORD (NOT your normal Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admin@conceptengineers.com.au 
# SMTP_PASSWORD=xxxx-xxxx-xxxx
# SMTP_FROM_NAME=Concept Engineers

# Microsoft Entra ID (Azure AD) — powers BOTH staff sign-in AND Graph email.
# Same app registration is used for both.
MS_TENANT_ID=xxxxxx-xxxxxxxx-xxxxxxxx
MS_CLIENT_ID=xxxxxx-xxxxxxxx-xxxxxxxx
MS_CLIENT_SECRET=xxxxxx-xxxxxxxx-xxxxxxxx
MAIL_SENDER=admin@conceptengineers.com.au
MAIL_SENDER_NAME=Concept Engineers

# ── Staff sign-in (Microsoft Entra ID) ───────────────────────────────────────
# Signs the session cookie — REQUIRED. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: restrict access to named staff (comma-separated). Leave blank to
# allow anyone in your Microsoft 365 tenant (sign-in is single-tenant already).
# STAFF_ALLOWED_EMAILS=gina@conceptengineers.com.au,admin@conceptengineers.com.au

# Set to false ONLY for local development to bypass sign-in. Never in production.
AUTH_ENABLED=true

# One-time Azure setup for sign-in (in addition to the Mail.Send permission):
#   1. App registration → Authentication → Add platform → Web
#   2. Redirect URI: {PUBLIC_BASE_URL}/auth/callback
#      e.g. https://proposal.conceptengineers.com.au/auth/callback
#      (also add http://localhost:5000/auth/callback for local dev)
#   3. API permissions → Microsoft Graph → Delegated → User.Read
#   4. Supported account types must be single tenant (this org only).

# DocuSeal removed
# Signing is fully self-hosted via SQLite (db.py) + reportlab/pypdf (signing.py).
